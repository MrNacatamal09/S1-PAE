<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" minHeight="500.0" minWidth="250.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sesion3.StudentCrontoller">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label fx:id="welcomeText" text="Universidad Americana" textFill="#0099ab">
      <font>
         <Font name="Times New Roman Bold" size="18.0" />
      </font></Label>
   <Label text="Registro de Notas" />
   <Pane prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: #0099ab; -fx-border-radius: 5;">
      <children>
         <VBox prefHeight="200.0" prefWidth="230.0" spacing="5.0">
            <children>
               <Label text="Nombre del Estudiante" />
               <TextField fx:id="txtName" promptText="Adolfo Carlos" />
               <Label text="Calificación" />
               <TextField fx:id="txtGrade" />
               <Button fx:id="btnSave" mnemonicParsing="false" onAction="#saveBtnClicked" text="Guardar" />
               <Label fx:id="lblAvg" text="Label" />
            </children>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
      </children>
   </Pane>
</VBox>
