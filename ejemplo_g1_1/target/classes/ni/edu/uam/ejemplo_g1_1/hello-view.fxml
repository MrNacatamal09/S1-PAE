<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      style="-fx-background-color: #0099AB"
      fx:controller="ni.edu.uam.ejemplo_g1_1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" style="-fx-background-color: #ffffff"/>
    <Label fx:id="lblName" style="-fx-background-color: #ffffff" text="Dime tu nombre"/>
    <TextField fx:id="tfName"/>
    <Button text="Saludar!" onAction="#onHelloButtonClick"/>
</VBox>
